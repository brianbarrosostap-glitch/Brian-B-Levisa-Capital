# =============================================================
# Edge Functions — secrets (NAMES ONLY — never commit real values)
#
# Real values live in each Supabase project:
#   Dashboard → Edge Functions → Secrets   (or `supabase secrets set ... --project-ref <ref>`)
#   DEV  = zwvjkhtehkpdjjrfyhhv (levisa-dev)
#   PROD = fhmdtbvpjqftwsbdihcu (live)
#
# These are SERVER-SIDE secrets. Never put them in the frontend .env —
# anything prefixed VITE_ is shipped to the browser.
#
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected
# by the platform automatically (the CLI rejects SUPABASE_* names). They are
# only needed here for fully-local `supabase functions serve --env-file`.
# =============================================================

# --- Local-serve only (auto-injected when deployed) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# --- Scheduler auth (pg_cron → functions). Same value must be in Vault as 'internal_secret'.
INTERNAL_SECRET=random-40-chars

# --- SMTP (Gmail App Password; port 465 — Supabase blocks 25/587)
SMTP_USER=brianbarroso.stap@gmail.com
SMTP_PASS=16-char-google-app-password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_FROM=Levisa Capital <brianbarroso.stap@gmail.com>

# --- DEV ONLY safety net — NEVER set these on PROD
# Recipients on these domains get mail normally; anyone else is redirected.
EMAIL_ALLOWED_DOMAINS=growwstacks.com
EMAIL_REDIRECT_TO=divyanshu.sharma@growwstacks.com
# Old n8n webhook calls are skipped when true (dev rows share prod ids).
DISABLE_N8N_WEBHOOKS=true

# --- Composio (Gmail read for RZR replies + Ryder confirmations; Drive/Sheets
#     only for Google Sheet links and the one-time Drive import)
COMPOSIO_API_KEY=ak_xxxxxxxxxxxxxxxx
COMPOSIO_USER_ID=pg-test-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
COMPOSIO_GMAIL_ACCOUNT_ID=ca_xxxxxxxxxxxx      # brianbarroso.stap@gmail.com
COMPOSIO_DRIVE_ACCOUNT_ID=ca_xxxxxxxxxxxx
COMPOSIO_SHEETS_ACCOUNT_ID=ca_xxxxxxxxxxxx

# --- Google Gemini (invoice PDFs + cheque photos)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# --- Your document services (no key needed today)
DOC_DOWNLOADER_URL=http://2.25.198.222:8000/download-pdf   # Docufree link → PDF (headless Chrome)
DOC_CONVERT_URL=http://187.127.167.132:8000/convert        # Excel/Office → PDF
